from asyncio import get_event_loop
from services.mikrotik_builder import build_mikrotik_script
import os
import datetime


def dispatch_router_provisioning(router: dict, background_tasks=None, mode: str = "script"):
    """
    Router Provisioning Dispatcher (Phase 1)

    Modes:
    - script: returns MikroTik RSC script (default)
    - file: saves script to /tmp
    """

    script = build_mikrotik_script(router)
    try:
        import asyncio
        import asyncio
        loop = asyncio.get_event_loop()
        if loop.is_running():
            loop.create_task(background_tasks.add_task(log_provisioning, router, script) if background_tasks else None)
    try:
        loop = asyncio.get_event_loop()
        loop.create_task(log_provisioning(router, script))
    except Exception as e:
        print("Provisioning log failed:", e)
    except Exception as e:
        print("Provisioning log failed:", e)

    # Basic metadata logging
    router_name = router.get("name", "unknown")
    timestamp = datetime.datetime.utcnow().isoformat()

    log_entry = f"[{timestamp}] Router={router_name} Mode={mode}"

    print(log_entry)

    # Mode: return script only (safe default)
    if mode == "script":
        return {
            "status": "success",
            "router": router_name,
            "script": script
        }

    # Mode: save to file (useful for debugging / ops)
    if mode == "file":
        filename = f"/tmp/{router_name}_mikrotik.rsc"
        with open(filename, "w") as f:
            f.write(script)

        return {
            "status": "saved",
            "router": router_name,
            "file": filename,
            "script": script
        }

    return {
        "status": "error",
        "message": f"Unknown mode: {mode}"
    }
